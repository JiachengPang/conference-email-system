# Environment files (never commit secrets)
.env
.env.*
!.env.example
# Redundant with .env.* above, stated explicitly so a future narrowing of that
# pattern cannot silently expose the mining credential (backend/.env.mining
# holds the OPENAI_API_KEY used only by scripts/data_mining/stage1_extract.py).
backend/.env.mining
docs/secrets.txt

# Pulled Zendesk ticket data (real user PII — never commit)
data/tickets/

# Style-guide distillation intermediates (ticket-derived text; the final
# style_guide_v1.md + manifest.json ARE committable)
data/style_guide/pairs.jsonl
data/style_guide/batches.json
data/style_guide/batches/

# Real-ticket eval set (ticket-derived text — PII)
data/eval_real/

# Labeling sets extracted from data/tickets (real PII) — never commit
data/labeling/

# Recovery-script reports (quote real ticket content — never commit)
backend/scripts/recovery/output/

# Chair -> Zendesk account file (personal data). It must live OUTSIDE the repo
# (load_chair_accounts.py refuses a path inside it); this is a second guard.
chair_accounts*.csv
chair_accounts*.private*

